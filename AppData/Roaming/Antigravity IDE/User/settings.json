{
    "git.autofetch": true,
    "terminal.integrated.profiles.windows": {
        "PowerShell (NoProfile)": {
            "path": "pwsh.exe",
            "args": [
                "-NoProfile"
            ]
        },
        "PowerShell (Mini)": {
            "path": "pwsh.exe",
            "icon": "terminal-powershell",
            "args": [
                "-NoProfile",
                "-NoExit",
                "-Command",
                ". '${env:USERPROFILE}\\Documents\\PowerShell\\mini_profile.ps1'"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (Mini)",
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Jet Brains Mono Nerd Font', 'JetBrainsMono NF', 'Vazirmatn', 'Segoe UI', monospace",
    "editor.fontSize": 14,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'Jet Brains Mono Nerd Font', 'JetBrainsMono NF', 'Vazirmatn', 'Segoe UI', monospace",
    "terminal.integrated.fontSize": 14
}
{{- $nameFile := joinPath .chezmoi.homeDir ".config" "name" -}}
{{- $hostName := "" -}}
{{- if stat $nameFile -}}
{{-   $hostName = trim (include $nameFile) -}}
{{- end -}}
# مسیر پیش‌فرض ذخیره فایل‌ها
dir={{ .chezmoi.homeDir }}/Downloads

{{ if eq $hostName "work" -}}
# بایند کردن ارتباطات دانلود به اینترفیس فیبر نوری VLAN 500 در سیستم کار (work)
interface=eno1
{{ else -}}
# در سایر سیستم‌ها به صورت پیش‌فرض از اینترفیس اصلی سیستم استفاده می‌شود
{{ end -}}

# ذخیره و بازیابی نشست دانلودها (حفظ وضعیت بعد از ری‌استارت)
input-file={{ .chezmoi.homeDir }}/.config/aria2/aria2.session
save-session={{ .chezmoi.homeDir }}/.config/aria2/aria2.session
save-session-interval=30

# تنظیمات RPC (جهت اتصال افزونه‌های مرورگر و وب‌اینترفیس AriaNg)
enable-rpc=true
rpc-allow-origin-all=true
rpc-listen-all=true
rpc-listen-port=6800
{{- $ariaSecretFile := joinPath .chezmoi.homeDir ".ssh" "secrets" "aria2.env" }}
{{- if stat $ariaSecretFile }}
{{-   range splitList "\n" (include $ariaSecretFile) }}
{{-     if hasPrefix "RPC_SECRET=" . }}
rpc-secret={{ trimPrefix "RPC_SECRET=" . }}
{{-     end }}
{{-   end }}
{{- end }}

# تنظیمات دانلود و کانکشن‌ها
continue=true
max-concurrent-downloads=5
max-connection-per-server=16
split=16
min-split-size=1M
piece-length=1M
disk-cache=64M
file-allocation=falloc

# متوقف کردن Seeding در تورنت‌ها (در صورت استفاده)
seed-time=0

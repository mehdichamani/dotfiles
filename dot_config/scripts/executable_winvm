#!/usr/bin/env bash

CONTAINER_NAME="WinApps"
COMPOSE_FILE="/home/unreal/docker/winapps/compose.yml"
IDLE_WAIT_SECONDS=1800
IDLE_MINUTES=$(( IDLE_WAIT_SECONDS / 60 ))
LOCK_FILE="/tmp/winapps_launcher.pid"

# Windows VM Credentials / Connection Details
RDP_HOST="127.0.0.1"
RDP_PORT="33389"
RDP_USER="MyWindowsUser"
RDP_PASS="MyWindowsPassword"

# 1. Cancel previous shutdown timer if running
if [ -f "$LOCK_FILE" ]; then
    PREV_PID=$(cat "$LOCK_FILE")
    kill "$PREV_PID" 2>/dev/null
    rm -f "$LOCK_FILE"
    echo "[+] Cancelled previous shutdown timer."
fi

# 2. Ensure container is up and running via Compose
if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" != "true" ]; then
    echo "[+] Container is down or stopped. Starting via Docker Compose..."
    docker compose -f "$COMPOSE_FILE" up -d > /dev/null 2>&1
    
    if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" != "true" ]; then
        docker start "$CONTAINER_NAME" > /dev/null 2>&1
    fi
fi

# 3. Wait until the RDP port is actively accepting connections
echo "[+] Waiting for Windows RDP service on port $RDP_PORT..."
MAX_ATTEMPTS=30
ATTEMPT=0

while ! timeout 1 bash -c "</dev/tcp/$RDP_HOST/$RDP_PORT" 2>/dev/null; do
    ATTEMPT=$((ATTEMPT + 1))
    if [ "$ATTEMPT" -ge "$MAX_ATTEMPTS" ]; then
        echo "[!] Timeout waiting for RDP service to become ready."
        exit 1
    fi
    sleep 2
done

sleep 2

# 4. Direct RDP Connection
echo "[+] Opening RDP session..."
export FREERDP_PASSWORD="$RDP_PASS"

xfreerdp /v:"$RDP_HOST":"$RDP_PORT" \
         /u:"$RDP_USER" \
         /p:"$FREERDP_PASSWORD" \
         /cert:ignore \
         /dynamic-resolution \
         /gfx \
         /sound \
         /clipboard \
         +home-drive

# 5. Window closed -> Dynamic countdown messaging
echo "[+] RDP window closed. Starting ${IDLE_MINUTES}-minute idle timer..."

(
    sleep "$IDLE_WAIT_SECONDS"
    echo "[+] ${IDLE_MINUTES} minutes elapsed. Stopping Docker Compose stack..."
    docker compose -f "$COMPOSE_FILE" stop > /dev/null 2>&1
    rm -f "$LOCK_FILE"
) &

echo $! > "$LOCK_FILE"
#!/usr/bin/env bash

CONTAINER_NAME="WinApps"
COMPOSE_FILE="$HOME/docker/winapps/compose.yml"
IDLE_WAIT_SECONDS=1800
IDLE_MINUTES=$(( IDLE_WAIT_SECONDS / 60 ))
LOCK_FILE="/tmp/winapps_launcher.pid"

# Windows VM Credentials / Connection Details
RDP_HOST="127.0.0.1"
RDP_PORT="33389"
RDP_USER="MyWindowsUser"
RDP_PASS="MyWindowsPassword"

# Send desktop notification and optionally print styled terminal log
notify() {
    local message="$1"
    local urgency="${2:-normal}" # normal, low, critical

    if [ -t 1 ]; then
        case "$urgency" in
            critical) echo -e "\e[1;31m[!] $message\e[0m" ;;
            low)      echo -e "\e[1;34m[*] $message\e[0m" ;;
            *)        echo -e "\e[1;32m[+] $message\e[0m" ;;
        esac
    fi

    if command -v notify-send >/dev/null 2>&1; then
        local icon="$HOME/.local/share/icons/hicolor/scalable/apps/winvm.svg"
        [ -f "$icon" ] || icon="winvm"
        notify-send -a "WinVM" -u "$urgency" -i "$icon" "WinVM" "$message"
    fi
}

# 1. Cancel previous shutdown timer if running
if [ -f "$LOCK_FILE" ]; then
    PREV_PID=$(cat "$LOCK_FILE" 2>/dev/null)
    if [ -n "$PREV_PID" ]; then
        kill "$PREV_PID" 2>/dev/null
    fi
    rm -f "$LOCK_FILE"
fi

# 2. Ensure container is up and running via Compose
if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" != "true" ]; then
    notify "Starting Windows VM container..." "normal"
    docker compose -f "$COMPOSE_FILE" up -d > /dev/null 2>&1

    if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER_NAME" 2>/dev/null)" != "true" ]; then
        docker start "$CONTAINER_NAME" > /dev/null 2>&1
    fi
fi

# 3. Wait until the RDP port is actively accepting connections
MAX_ATTEMPTS=30
ATTEMPT=0

while ! timeout 1 bash -c "</dev/tcp/$RDP_HOST/$RDP_PORT" 2>/dev/null; do
    ATTEMPT=$((ATTEMPT + 1))
    if [ "$ATTEMPT" -ge "$MAX_ATTEMPTS" ]; then
        notify "Timeout waiting for Windows RDP service." "critical"
        exit 1
    fi
    sleep 1
done

sleep 1

# 4. Direct RDP Connection
export FREERDP_PASSWORD="$RDP_PASS"

xfreerdp /v:"$RDP_HOST":"$RDP_PORT" \
         /u:"$RDP_USER" \
         /p:"$FREERDP_PASSWORD" \
         /cert:ignore \
         /dynamic-resolution \
         /gfx \
         /sound \
         /clipboard \
         +home-drive > /dev/null 2>&1

# 5. Window closed -> Dynamic countdown messaging
notify "RDP session closed. VM will stop in ${IDLE_MINUTES}m if unused." "normal"

(
    sleep "$IDLE_WAIT_SECONDS"
    docker compose -f "$COMPOSE_FILE" stop > /dev/null 2>&1
    rm -f "$LOCK_FILE"
    notify "Idle timeout reached. Windows VM stopped." "normal"
) > /dev/null 2>&1 &

echo $! > "$LOCK_FILE"
{
  "workbench.colorTheme": "Catppuccin Frappé",
  "update.mode": "none",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "workbench.startupEditor": "none",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Vazirmatn, monospace",
  "editor.renderWhitespace": "boundary",
  "js/ts.experimental.useTsgo": true,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', Vazirmatn, monospace",
  "markdown.preview.fontFamily": "Vazirmatn, 'JetBrainsMono Nerd Font', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
  "editor.fontLigatures": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "editor.wordWrap": "on",
  "markdown.preview.fontSize": 15,
  "markdown.preview.lineHeight": 1.7,
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "terminal.integrated.defaultProfile.linux": "fish",
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  }
}

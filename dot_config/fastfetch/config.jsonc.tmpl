{{- $device := "" -}}
{{- if hasKey . "deviceName" -}}
  {{- $device = .deviceName -}}
{{- else if eq .chezmoi.os "windows" -}}
  {{- $device = "work" -}}
{{- else if eq .chezmoi.os "android" -}}
  {{- $device = "s24" -}}
{{- else -}}
  {{- $device = "home" -}}
{{- end -}}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "position": "top",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "󰮯 {user-name-colored}@{host-name-colored}"
    },
    "break",
    {
      "type": "os",
      "key": "󰣇 os",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 wm",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "󰞷 sh",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " tm",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󰅐 up",
      "keyColor": "cyan",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu",
      "keyColor": "green",
      "format": "{name}"
    },
{{- if eq $device "home" }}
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "green",
      "format": "{name} free {size-free} ({size-percentage})",
      "folders": [
        "/mnt/ssd",
        "/run/media/unreal/TUF_Data",
        "/run/media/unreal/TUF_Backup",
        "/run/media/unreal/TUF_Public"
      ]
    },
{{- else if eq $device "work" }}
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "green",
      "format": "C: ({name}) free {size-free} ({size-percentage})",
      "folders": [
        "C:\\"
      ]
    },
{{- else if eq $device "s24" }}
    {
      "type": "disk",
      "key": "󰋊 disk",
      "keyColor": "green",
      "format": "{name} free {size-free} ({size-percentage})",
      "folders": [
        "/storage/emulated"
      ]
    },
{{- end }}
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "position": "top",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 0
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "format": "󰮯 {user-name-colored}@{host-name-colored}"
    },
    "break",
    {
      "type": "os",
      "key": "󰣇 os",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 wm",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "󰞷 sh",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": " tm",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󰅐 up",
      "keyColor": "cyan",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
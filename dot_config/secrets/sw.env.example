# Cisco Switches Telnet Credentials Configuration
# Copy this file to sw.env (in ~/.config/secrets/sw.env) and set your password:
#   cp ~/.config/secrets/sw.env.example ~/.config/secrets/sw.env

# Switch login username (leave empty if your switch only asks for password)
SWITCH_USER=

# Switch login password (required)
SWITCH_PASS=your_switch_password_here
